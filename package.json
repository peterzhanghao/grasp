{
  "name": "@local/loop-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "掌控（Grasp）：看清一个系统如何纠正自己，也看清你凭什么相信它。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./data/core.json": "./data/core.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.js",
    "data/core.json",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build/build-client.mjs",
    "test": "node --test test/domain test/content test/client"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
